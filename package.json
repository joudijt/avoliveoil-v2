{
  "name": "avoliveoil-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:slugs && npm run check:images && npm run check:product-photos && npm run build:llms && node scripts/ai/surfaces.mjs && npm run check:facts && node scripts/gen-ar-redirects.mjs --check && tsc -b && vite build && node scripts/cms-build-data.mjs && node scripts/copy-server.mjs",
    "cms:data": "node scripts/cms-build-data.mjs",
    "check:cms": "node scripts/check-bundles.mjs && node scripts/check-cms-classes.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "sitemap:manifest": "node scripts/generate-sitemap.mjs --update-manifest",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "prerender": "node scripts/prerender.mjs",
    "build:prerender": "npm run build && npm run prerender && npm run check:facts:dist",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:llms": "node scripts/build-llms.mjs",
    "check:llms": "node scripts/build-llms.mjs --check",
    "ai:surfaces": "node scripts/ai/surfaces.mjs",
    "ai:facts": "node scripts/ai/facts-sync.mjs",
    "check:ai": "node scripts/ai/facts-sync.mjs --check",
    "check:facts": "node scripts/check-facts.mjs",
    "check:facts:dist": "node scripts/check-facts.mjs --dist",
    "product-photos": "python scripts/product-photos.py",
    "check:product-photos": "python scripts/product-photos.py --check",
    "images": "python scripts/optimize-images.py",
    "check:images": "python scripts/optimize-images.py --check",
    "check:slugs": "node scripts/check-article-slugs.mjs",
    "perf": "node scripts/perf-probe.mjs",
    "check:brand": "python scripts/brand-assets.py --check",
    "check:heads": "python scripts/check-heads.py",
    "check:hydration": "node scripts/check-hydration.mjs",
    "ai:coverage": "node scripts/ai/coverage.mjs --facts AI-FACTS.yml",
    "ai:gate": "node scripts/ai/gate.mjs --url https://avoliveoil.com",
    "ai:indexnow": "node scripts/ai/indexnow.mjs --sitemap",
    "ai:answers": "node scripts/ai/answer-blocks.mjs --list"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "i18next": "^26.3.6",
    "lenis": "^1.3.25",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.10",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
