# Arabian Village — avoliveoil.com
# Pages are prerendered snapshots (dist/<lang>/<path>/index.html). Since the control
# panel (docs/cms/CMS-SPEC.md §13.1) every page URL is answered by the rendered-page
# store /_r/<lang>/<path>/index.html when it exists, else by /api/serve.php, which
# applies the owner's published edits to the snapshot (or renders a CMS page), writes
# the /_r file and returns it. PHP therefore runs only on a cache miss.
# The order of the rules below is part of the spec (§13.1) — do not reorder.

Options -Indexes
DirectoryIndex index.html

# /en /ms are directories on disk. Without this, Apache's DirectorySlash
# 301-redirects /en -> /en/, which contradicts the canonical, hreflang and
# sitemap URLs (all slash-less).
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 2. www. and bare answer 200 with no redirect, so Google indexes them as three
  # separate homepages despite the matching canonical tag (found live in GSC
  # 2026-09-10: www./bare/en all return 200, canonical is ignored because the
  # duplicate is never redirected away). Fold www. into the apex before any
  # other rule runs.
  RewriteCond %{HTTP_HOST} ^www\.avoliveoil\.com$ [NC]
  RewriteRule ^ https://avoliveoil.com%{REQUEST_URI} [R=301,L]

  # 3. Arabic removal (generated block, untouched) ...
  # BEGIN ar-redirects (generated by scripts/gen-ar-redirects.mjs)
  # Arabic was removed from the site on 2026-10-01. Every old /ar URL 301s to
  # its closest English page. Do not hand-edit: change the table in the script
  # and re-run it. [NC]: /AR/... and /Ar/... redirect in one hop too.
  RewriteRule ^ar/blog/why-olive-oil-is-becoming-popular-in-malaysia/?$ /en/blog/why-olive-oil-is-becoming-popular-in-malaysia [NC,R=301,L]
  RewriteRule ^ar/blog/extra-virgin-olive-oil-health-benefits-for-malaysian-families/?$ /en/blog/extra-virgin-olive-oil-health-benefits-for-malaysian-families [NC,R=301,L]
  RewriteRule ^ar/blog/how-to-choose-authentic-extra-virgin-olive-oil-in-malaysia/?$ /en/blog/how-to-choose-authentic-extra-virgin-olive-oil-in-malaysia [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-zaytun-falastini-ma-yumayyizuh/?$ /en/blog/palestinian-olive-oil-what-makes-it-different [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lil-tabkh/?$ /en/blog/how-to-cook-with-olive-oil-in-a-malaysian-kitchen [NC,R=301,L]
  RewriteRule ^ar/blog/hifz-zayt-alzaytun/?$ /en/blog/olive-oil-shelf-life-how-long-a-bottle-lasts [NC,R=301,L]
  RewriteRule ^ar/blog/sier-zayt-alzaytun-fi-malizya/?$ /en/blog/olive-oil-price-in-malaysia-what-you-are-paying-for [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-fi-kuala-lumpur/?$ /en/blog/extra-virgin-olive-oil-in-malaysia [NC,R=301,L]
  RewriteRule ^ar/blog/alfarq-bayn-zayt-alzaytun-albikr-walmumtaz/?$ /en/blog/extra-virgin-olive-oil-vs-pure-olive-oil [NC,R=301,L]
  RewriteRule ^ar/blog/darajat-humudat-zayt-alzaytun/?$ /en/blog/how-to-choose-authentic-extra-virgin-olive-oil-in-malaysia [NC,R=301,L]
  RewriteRule ^ar/blog/taem-zayt-alzaytun-albikr-almumtaz/?$ /en/blog/why-does-olive-oil-taste-bitter [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-aludwi/?$ /en/blog/how-to-choose-authentic-extra-virgin-olive-oil-in-malaysia [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilqaly/?$ /en/blog/olive-oil-smoke-point-what-heat-it-can-take [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilsalata/?$ /en/blog/extra-virgin-olive-oil-salad-dressing [NC,R=301,L]
  RewriteRule ^ar/blog/kayf-tukhtar-afdal-zayt-zaytun/?$ /en/blog/best-extra-virgin-olive-oil-in-malaysia [NC,R=301,L]
  RewriteRule ^ar/blog/mawsim-qitaf-alzaytun/?$ /en/blog/olive-oil-harvest-season-early-vs-late [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-almukarrar/?$ /en/blog/extra-virgin-olive-oil-vs-pure-olive-oil [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-hasab-balad-almansha/?$ /en/blog/how-to-compare-olive-oil-brands-in-malaysia [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-zaytun-baladi/?$ /en/blog/palestinian-olive-oil-what-makes-it-different [NC,R=301,L]
  RewriteRule ^ar/blog/zujajat-zayt-alzaytun/?$ /en/blog/what-size-olive-oil-bottle-to-buy [NC,R=301,L]
  RewriteRule ^ar/blog/anwae-alzaytun-lilzayt/?$ /en/blog/olive-oil-varieties-arbequina-koroneiki-and-more [NC,R=301,L]
  RewriteRule ^ar/blog/tajmid-zayt-alzaytun/?$ /en/blog/why-is-my-olive-oil-cloudy [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-fi-ramadan/?$ /en/blog/extra-virgin-olive-oil-health-benefits-for-malaysian-families [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilmuajanat/?$ /en/blog/olive-oil-for-cakes-and-baking [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilshawi/?$ /en/blog/olive-oil-for-grilling-and-barbecue [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-walzaatar/?$ /en/products/infused-extra-virgin-olive-oil-wild-thyme [NC,R=301,L]
  RewriteRule ^ar/blog/hal-yumkin-an-yakun-zayt-alzaytun-rakhisan/?$ /en/blog/olive-oil-price-in-malaysia-what-you-are-paying-for [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilbayd/?$ /en/blog/olive-oil-fried-egg [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilfawshar/?$ /en/blog/olive-oil-popcorn [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilkhudar-almashwi/?$ /en/blog/olive-oil-for-roasting-vegetables [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilsteak/?$ /en/blog/olive-oil-for-steak [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-walzubda/?$ /en/blog/olive-oil-vs-butter [NC,R=301,L]
  RewriteRule ^ar/blog/ays-krim-bizayt-alzaytun/?$ /en/blog/olive-oil-ice-cream [NC,R=301,L]
  RewriteRule ^ar/blog/kaykat-alburtuqal-bizayt-alzaytun/?$ /en/blog/olive-oil-orange-cake [NC,R=301,L]
  RewriteRule ^ar/blog/qahwat-bizayt-alzaytun/?$ /en/blog/olive-oil-coffee [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilbatatis-almahrusa/?$ /en/blog/olive-oil-mashed-potatoes [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-walsimsim/?$ /en/blog/olive-oil-vs-sesame-oil [NC,R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-wazayt-abad-alshams/?$ /en/blog/olive-oil-vs-sunflower-oil [NC,R=301,L]
  RewriteRule ^ar/products/([a-z0-9-]+)/?$ /en/products/$1 [NC,R=301,L]
  RewriteRule ^ar/(products|shop|why-us|contact|blog)/?$ /en/$1 [NC,R=301,L]
  RewriteRule ^ar/?$ /en [NC,R=301,L]
  RewriteRule ^ar/.*$ /en [NC,R=301,L]
  # END ar-redirects

  # The block above is [NC], so /AR/... and /Ar/... already 301 in one hop. The Arabic
  # llms brief folds into the English one.
  RewriteRule ^llms-ar\.txt$ /llms.txt [NC,R=301,L]

  # 4. Internal stores are never reachable from outside. THE_REQUEST is the raw
  # request line, so the internal rewrites below (to /_r/... and /api/...) still work.
  RewriteCond %{THE_REQUEST} \s/+(_r|api/_lib|api/_data|api/_setup|api/tests)(/|\?|\s) [NC]
  RewriteRule ^ - [R=404,L]

  # 5. The JSON API: everything under /api/ except the three real entry points.
  RewriteCond %{REQUEST_URI} !^/api/(index|serve|sitemap)\.php$
  RewriteRule ^api(/.*)?$ /api/index.php [L]

  # 6. Sitemap = static build sitemap + published CMS pages.
  RewriteRule ^sitemap\.xml$ /api/sitemap.php [L]

  # 7. Control panel (its own Vite entry). noindex is sent by the <Files> block below.
  RewriteRule ^admin(/.*)?$ /admin.html [L]

  # 8. A snapshot file is never a public URL: /en/why-us/index.html -> /en/why-us,
  # and the CMS page template answers 404 under any name.
  RewriteCond %{THE_REQUEST} \s/+((?:en|ms)(?:/[^\s?]*?)?)/index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  RewriteRule (^|/)(__)?cms-template(/|$) - [NC,R=404,L]

  # 9. Uppercase in a page URL: serve.php answers with a 301 to the lowercase URL
  # (mod_rewrite cannot lowercase without a RewriteMap, which .htaccess can't declare).
  RewriteCond %{REQUEST_URI} [A-Z]
  RewriteRule ^(en|ms)(/.*)?$ /api/serve.php [NC,L]

  # 10. Trailing slash -> slashless (/en/ -> /en, /en/why-us/ -> /en/why-us).
  RewriteRule ^((?:en|ms)(?:/[a-z0-9-]+)*)/$ /$1 [R=301,L]

  # 11. Page URLs: the rendered store when the file exists, else serve.php.
  # Requests that ask for the edit / preview mode or the self-test always reach PHP.
  RewriteCond %{QUERY_STRING} !(^|&)(cms-|selftest) [NC]
  RewriteCond %{DOCUMENT_ROOT}/_r/en/index.html -f
  RewriteRule ^$ /_r/en/index.html [L]
  RewriteRule ^$ /api/serve.php [L]
  RewriteCond %{QUERY_STRING} !(^|&)(cms-|selftest) [NC]
  RewriteCond %{DOCUMENT_ROOT}/_r/$1/index.html -f
  RewriteRule ^((?:en|ms)(?:/[a-z0-9-]+)*)$ /_r/$1/index.html [L]
  RewriteRule ^(?:en|ms)(?:/[a-z0-9-]+)*$ /api/serve.php [L]

  # 12. The page builder's canvas is a route of the public app (noindex in-app).
  RewriteRule ^cms-canvas$ /index.html [L]

  # 13. Real files and real directories win.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 14. A path with a file extension is an asset, not a route. Real ones were served
  # by the -f/-d passthrough above, so anything reaching here does not exist and
  # must say so. Without this the SPA fallback answers 200 with the 442-byte
  # shell for every missing asset — a soft 404 that a crawler, a schema
  # validator and a link checker all read as a real page. Verified live
  # 2026-08-18: /faq.md returned 200 text/html before this rule existed.
  # 2,12 not 2,5: ".webmanifest" is eleven characters. Routes on this site never
  # contain a dot, so widening is safe. /api/ is excluded: rule 5 owns it.
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule \.[A-Za-z0-9]{2,12}$ - [R=404,L]

  # 15. Everything else -> SPA shell
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed build assets — immutable
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # HTML must revalidate or deploys never reach returning visitors
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
    # Same policy serve.php sends with the pages it renders (spec §13.1). JSON-LD and
    # the #cms-boot payload are data blocks, so script-src 'self' does not block them.
    Header set Content-Security-Policy "script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
  </FilesMatch>
  # The control panel is never indexed (the canvas route sets its own noindex meta).
  <Files "admin.html">
    Header set X-Robots-Tag "noindex, nofollow"
  </Files>
</IfModule>

AddType text/plain .txt
AddDefaultCharset UTF-8

# Markdown surfaces (/about.md, /pricing.md, /faq.md, /AGENTS.md). Without a type
# the host serves .md as application/octet-stream, which makes a browser download
# the file and makes some crawlers skip it. This box (the same one Sihatree runs
# on) has been seen to drop the charset from AddType on later requests, so
# mod_headers re-sets it after the type is chosen.
AddType "text/markdown; charset=UTF-8" .md
<IfModule mod_headers.c>
  <FilesMatch "\.md$">
    Header set Content-Type "text/markdown; charset=UTF-8"
  </FilesMatch>
</IfModule>

# Brand assets. The web manifest has its own registered type and is refused by
# some browsers when served as octet-stream; the icons are long-lived because
# their content only changes when the logo does, and the manifest is short-lived
# because it names them.
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType image/x-icon .ico
<IfModule mod_headers.c>
  <FilesMatch "\.(webmanifest)$">
    Header set Content-Type "application/manifest+json; charset=UTF-8"
    Header set Cache-Control "public, max-age=3600"
    Header unset Expires
  </FilesMatch>
  # mod_expires above gives every png/jpeg/svg "access plus 1 year". That is
  # right for hashed build assets under /assets/ and wrong for these: it is why
  # the old purple template favicon would otherwise stay in a returning
  # visitor's tab until 2027. One week, and re-verify with curl -I after deploy.
  <FilesMatch "^(favicon.*|apple-touch-icon|mask-icon|logo|logo-512|og-image|og-card.*|icon-.*)\.(svg|png|ico|jpg)$">
    Header set Cache-Control "public, max-age=604800"
    # mod_expires emits its own Expires: 2027 header for these types and a
    # Cache-Control set here does not remove it. Two conflicting freshness
    # headers on a LiteSpeed box emulating both modules is not worth relying on
    # RFC precedence for — drop the stale one outright.
    Header unset Expires
  </FilesMatch>
</IfModule>

ErrorDocument 404 /index.html
