# Arabian Village — avoliveoil.com
# SPA served from the docroot. /en /ar /ms are real prerendered directories
# (dist/<lang>/index.html) so DirectoryIndex serves them for crawlers; anything
# else falls back to the SPA shell and react-router takes over.

Options -Indexes
DirectoryIndex index.html

# /en /ar /ms are directories on disk. Without this, Apache's DirectorySlash
# 301-redirects /en -> /en/, which contradicts the canonical, hreflang and
# sitemap URLs (all slash-less). Serve the prerendered file directly instead.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Language roots -> prerendered snapshot, no redirect, slash optional
  RewriteRule ^(en|ar|ms)/?$ /$1/index.html [L]

  # Prerendered sub-pages -> their own snapshot, same slash-optional rule
  RewriteRule ^(en|ar|ms)/(products|shop|why-us|contact|blog)/?$ /$1/$2/index.html [L]

  # Blog articles: /<lang>/blog/<slug> is also a prerendered directory. Slugs are
  # lowercase ASCII with hyphens in every language, so one pattern covers all
  # three. The -f guard means an unknown slug falls through to the SPA shell
  # (which redirects to the blog index) instead of returning a hard 404.
  RewriteCond %{DOCUMENT_ROOT}/$1/blog/$2/index.html -f
  RewriteRule ^(en|ar|ms)/blog/([a-z0-9-]+)/?$ /$1/blog/$2/index.html [L]

  # Product detail pages: /<lang>/products/<slug> is also a prerendered
  # directory, same contract as the blog articles above. Without this rule the
  # request falls through to the -d passthrough and Apache 301s to the
  # trailing-slash URL, contradicting the slash-less canonicals.
  RewriteCond %{DOCUMENT_ROOT}/$1/products/$2/index.html -f
  RewriteRule ^(en|ar|ms)/products/([a-z0-9-]+)/?$ /$1/products/$2/index.html [L]

  # Real files and real directories win (keeps /en /ar /ms prerendered HTML)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # A path with a file extension is an asset, not a route. Real ones were served
  # by the -f/-d passthrough above, so anything reaching here does not exist and
  # must say so. Without this the SPA fallback answers 200 with the 442-byte
  # shell for every missing asset — a soft 404 that a crawler, a schema
  # validator and a link checker all read as a real page. Verified live
  # 2026-08-18: /faq.md returned 200 text/html before this rule existed.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule \.[A-Za-z0-9]{2,5}$ - [R=404,L]

  # Everything else -> SPA shell
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed build assets — immutable
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # HTML must revalidate or deploys never reach returning visitors
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

AddType text/plain .txt
AddDefaultCharset UTF-8

# Markdown surfaces (/about.md, /pricing.md, /faq.md, /AGENTS.md). Without a type
# the host serves .md as application/octet-stream, which makes a browser download
# the file and makes some crawlers skip it. This box (the same one Sihatree runs
# on) has been seen to drop the charset from AddType on later requests, so
# mod_headers re-sets it after the type is chosen.
AddType "text/markdown; charset=UTF-8" .md
<IfModule mod_headers.c>
  <FilesMatch "\.md$">
    Header set Content-Type "text/markdown; charset=UTF-8"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /index.html
