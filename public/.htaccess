# Arabian Village — avoliveoil.com
# SPA served from the docroot. /en /ms are real prerendered directories
# (dist/<lang>/index.html) so DirectoryIndex serves them for crawlers; anything
# else falls back to the SPA shell and react-router takes over.

Options -Indexes
DirectoryIndex index.html

# /en /ms are directories on disk. Without this, Apache's DirectorySlash
# 301-redirects /en -> /en/, which contradicts the canonical, hreflang and
# sitemap URLs (all slash-less). Serve the prerendered file directly instead.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # www. and bare answer 200 with no redirect, so Google indexes them as three
  # separate homepages despite the matching canonical tag (found live in GSC
  # 2026-09-10: www./bare/en all return 200, canonical is ignored because the
  # duplicate is never redirected away). Fold www. into the apex before any
  # other rule runs.
  RewriteCond %{HTTP_HOST} ^www\.avoliveoil\.com$ [NC]
  RewriteRule ^ https://avoliveoil.com%{REQUEST_URI} [R=301,L]

  # BEGIN ar-redirects (generated by scripts/gen-ar-redirects.mjs)
  # Arabic was removed from the site on 2026-10-01. Every old /ar URL 301s to
  # its closest English page. Do not hand-edit: change the table in the script
  # and re-run it.
  RewriteRule ^ar/blog/why-olive-oil-is-becoming-popular-in-malaysia/?$ /en/blog/why-olive-oil-is-becoming-popular-in-malaysia [R=301,L]
  RewriteRule ^ar/blog/extra-virgin-olive-oil-health-benefits-for-malaysian-families/?$ /en/blog/extra-virgin-olive-oil-health-benefits-for-malaysian-families [R=301,L]
  RewriteRule ^ar/blog/how-to-choose-authentic-extra-virgin-olive-oil-in-malaysia/?$ /en/blog/how-to-choose-authentic-extra-virgin-olive-oil-in-malaysia [R=301,L]
  RewriteRule ^ar/blog/zayt-zaytun-falastini-ma-yumayyizuh/?$ /en/blog/palestinian-olive-oil-what-makes-it-different [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lil-tabkh/?$ /en/blog/how-to-cook-with-olive-oil-in-a-malaysian-kitchen [R=301,L]
  RewriteRule ^ar/blog/hifz-zayt-alzaytun/?$ /en/blog/olive-oil-shelf-life-how-long-a-bottle-lasts [R=301,L]
  RewriteRule ^ar/blog/sier-zayt-alzaytun-fi-malizya/?$ /en/blog/olive-oil-price-in-malaysia-what-you-are-paying-for [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-fi-kuala-lumpur/?$ /en/blog/extra-virgin-olive-oil-in-malaysia [R=301,L]
  RewriteRule ^ar/blog/alfarq-bayn-zayt-alzaytun-albikr-walmumtaz/?$ /en/blog/extra-virgin-olive-oil-vs-pure-olive-oil [R=301,L]
  RewriteRule ^ar/blog/darajat-humudat-zayt-alzaytun/?$ /en/blog/how-to-choose-authentic-extra-virgin-olive-oil-in-malaysia [R=301,L]
  RewriteRule ^ar/blog/taem-zayt-alzaytun-albikr-almumtaz/?$ /en/blog/why-does-olive-oil-taste-bitter [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-aludwi/?$ /en/blog/how-to-choose-authentic-extra-virgin-olive-oil-in-malaysia [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilqaly/?$ /en/blog/olive-oil-smoke-point-what-heat-it-can-take [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilsalata/?$ /en/blog/extra-virgin-olive-oil-salad-dressing [R=301,L]
  RewriteRule ^ar/blog/kayf-tukhtar-afdal-zayt-zaytun/?$ /en/blog/best-extra-virgin-olive-oil-in-malaysia [R=301,L]
  RewriteRule ^ar/blog/mawsim-qitaf-alzaytun/?$ /en/blog/olive-oil-harvest-season-early-vs-late [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-almukarrar/?$ /en/blog/extra-virgin-olive-oil-vs-pure-olive-oil [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-hasab-balad-almansha/?$ /en/blog/how-to-compare-olive-oil-brands-in-malaysia [R=301,L]
  RewriteRule ^ar/blog/zayt-zaytun-baladi/?$ /en/blog/palestinian-olive-oil-what-makes-it-different [R=301,L]
  RewriteRule ^ar/blog/zujajat-zayt-alzaytun/?$ /en/blog/what-size-olive-oil-bottle-to-buy [R=301,L]
  RewriteRule ^ar/blog/anwae-alzaytun-lilzayt/?$ /en/blog/olive-oil-varieties-arbequina-koroneiki-and-more [R=301,L]
  RewriteRule ^ar/blog/tajmid-zayt-alzaytun/?$ /en/blog/why-is-my-olive-oil-cloudy [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-fi-ramadan/?$ /en/blog/extra-virgin-olive-oil-health-benefits-for-malaysian-families [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilmuajanat/?$ /en/blog/olive-oil-for-cakes-and-baking [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilshawi/?$ /en/blog/olive-oil-for-grilling-and-barbecue [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-walzaatar/?$ /en/products/infused-extra-virgin-olive-oil-wild-thyme [R=301,L]
  RewriteRule ^ar/blog/hal-yumkin-an-yakun-zayt-alzaytun-rakhisan/?$ /en/blog/olive-oil-price-in-malaysia-what-you-are-paying-for [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilbayd/?$ /en/blog/olive-oil-fried-egg [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilfawshar/?$ /en/blog/olive-oil-popcorn [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilkhudar-almashwi/?$ /en/blog/olive-oil-for-roasting-vegetables [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilsteak/?$ /en/blog/olive-oil-for-steak [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-walzubda/?$ /en/blog/olive-oil-vs-butter [R=301,L]
  RewriteRule ^ar/blog/ays-krim-bizayt-alzaytun/?$ /en/blog/olive-oil-ice-cream [R=301,L]
  RewriteRule ^ar/blog/kaykat-alburtuqal-bizayt-alzaytun/?$ /en/blog/olive-oil-orange-cake [R=301,L]
  RewriteRule ^ar/blog/qahwat-bizayt-alzaytun/?$ /en/blog/olive-oil-coffee [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-lilbatatis-almahrusa/?$ /en/blog/olive-oil-mashed-potatoes [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-walsimsim/?$ /en/blog/olive-oil-vs-sesame-oil [R=301,L]
  RewriteRule ^ar/blog/zayt-alzaytun-wazayt-abad-alshams/?$ /en/blog/olive-oil-vs-sunflower-oil [R=301,L]
  RewriteRule ^ar/products/([a-z0-9-]+)/?$ /en/products/$1 [R=301,L]
  RewriteRule ^ar/(products|shop|why-us|contact|blog)/?$ /en/$1 [R=301,L]
  RewriteRule ^ar/?$ /en [R=301,L]
  RewriteRule ^ar/.*$ /en [R=301,L]
  # END ar-redirects

  # The bare domain used to fall through to DirectoryIndex and serve the empty
  # 442-byte SPA shell: no title, no description, no og:image, no JSON-LD. That
  # is the single most-shared URL of the site (pasting avoliveoil.com into
  # WhatsApp produced nothing) and it is what scripts/ai/gate.mjs fetches for its
  # homepage checks. Serve the prerendered English page instead; its canonical
  # already points at /en, so this adds no duplicate URL.
  RewriteRule ^$ /en/index.html [L]

  # Language roots -> prerendered snapshot, no redirect, slash optional
  RewriteRule ^(en|ms)/?$ /$1/index.html [L]

  # Prerendered sub-pages -> their own snapshot, same slash-optional rule
  RewriteRule ^(en|ms)/(products|shop|why-us|contact|blog)/?$ /$1/$2/index.html [L]

  # Blog articles: /<lang>/blog/<slug> is also a prerendered directory. Slugs are
  # lowercase ASCII with hyphens in every language, so one pattern covers
  # both. The -f guard means an unknown slug falls through to the SPA shell
  # (which redirects to the blog index) instead of returning a hard 404.
  RewriteCond %{DOCUMENT_ROOT}/$1/blog/$2/index.html -f
  RewriteRule ^(en|ms)/blog/([a-z0-9-]+)/?$ /$1/blog/$2/index.html [L]

  # Product detail pages: /<lang>/products/<slug> is also a prerendered
  # directory, same contract as the blog articles above. Without this rule the
  # request falls through to the -d passthrough and Apache 301s to the
  # trailing-slash URL, contradicting the slash-less canonicals.
  RewriteCond %{DOCUMENT_ROOT}/$1/products/$2/index.html -f
  RewriteRule ^(en|ms)/products/([a-z0-9-]+)/?$ /$1/products/$2/index.html [L]

  # Real files and real directories win (keeps /en /ms prerendered HTML)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # A path with a file extension is an asset, not a route. Real ones were served
  # by the -f/-d passthrough above, so anything reaching here does not exist and
  # must say so. Without this the SPA fallback answers 200 with the 442-byte
  # shell for every missing asset — a soft 404 that a crawler, a schema
  # validator and a link checker all read as a real page. Verified live
  # 2026-08-18: /faq.md returned 200 text/html before this rule existed.
  # 2,12 not 2,5: ".webmanifest" is eleven characters, so it fell outside the
  # old range and a missing/failed-upload manifest answered 200 with the shell —
  # the exact soft-404 this rule exists to stop, invisible to any status check.
  # Routes on this site never contain a dot, so widening is safe.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule \.[A-Za-z0-9]{2,12}$ - [R=404,L]

  # Everything else -> SPA shell
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed build assets — immutable
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # HTML must revalidate or deploys never reach returning visitors
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

AddType text/plain .txt
AddDefaultCharset UTF-8

# Markdown surfaces (/about.md, /pricing.md, /faq.md, /AGENTS.md). Without a type
# the host serves .md as application/octet-stream, which makes a browser download
# the file and makes some crawlers skip it. This box (the same one Sihatree runs
# on) has been seen to drop the charset from AddType on later requests, so
# mod_headers re-sets it after the type is chosen.
AddType "text/markdown; charset=UTF-8" .md
<IfModule mod_headers.c>
  <FilesMatch "\.md$">
    Header set Content-Type "text/markdown; charset=UTF-8"
  </FilesMatch>
</IfModule>

# Brand assets. The web manifest has its own registered type and is refused by
# some browsers when served as octet-stream; the icons are long-lived because
# their content only changes when the logo does, and the manifest is short-lived
# because it names them.
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType image/x-icon .ico
<IfModule mod_headers.c>
  <FilesMatch "\.(webmanifest)$">
    Header set Content-Type "application/manifest+json; charset=UTF-8"
    Header set Cache-Control "public, max-age=3600"
    Header unset Expires
  </FilesMatch>
  # mod_expires above gives every png/jpeg/svg "access plus 1 year". That is
  # right for hashed build assets under /assets/ and wrong for these: it is why
  # the old purple template favicon would otherwise stay in a returning
  # visitor's tab until 2027. One week, and re-verify with curl -I after deploy.
  <FilesMatch "^(favicon.*|apple-touch-icon|mask-icon|logo|logo-512|og-image|og-card.*|icon-.*)\.(svg|png|ico|jpg)$">
    Header set Cache-Control "public, max-age=604800"
    # mod_expires emits its own Expires: 2027 header for these types and a
    # Cache-Control set here does not remove it. Two conflicting freshness
    # headers on a LiteSpeed box emulating both modules is not worth relying on
    # RFC precedence for — drop the stale one outright.
    Header unset Expires
  </FilesMatch>
</IfModule>

ErrorDocument 404 /index.html
